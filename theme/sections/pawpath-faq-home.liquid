{% comment %}
  Homepage FAQ — reduces pre-purchase anxiety before newsletter/footer.
{% endcomment %}

<section class="pawpath pawpath__section pawpath__section--sand" id="pawpath-faq-{{ section.id }}">
  <div class="pawpath__container">
    <div class="pawpath__section-header pawpath__section-header--center">
      <p class="pawpath__eyebrow">{{ section.settings.eyebrow }}</p>
      <h2 class="pawpath__heading pawpath__heading--section">{{ section.settings.heading }}</h2>
      {% if section.settings.subheading != blank %}
        <p class="pawpath__lead pawpath__lead--center">{{ section.settings.subheading }}</p>
      {% endif %}
    </div>

    <div class="pawpath__faq pawpath__faq--centered pawpath__faq--home">
      {% for block in section.blocks %}
        {% if block.type == 'faq' %}
          <details class="pawpath__faq-item" {{ block.shopify_attributes }}>
            <summary>{{ block.settings.question }}</summary>
            <div class="pawpath__faq-answer">{{ block.settings.answer }}</div>
          </details>
        {% endif %}
      {% endfor %}
    </div>

    {% if section.settings.support_label != blank %}
      <div class="pawpath__faq-support">
        <p>{{ section.settings.support_text }}</p>
        <a class="pawpath__button pawpath__button--outline" href="{{ section.settings.support_link | default: '/pages/contact' }}">
          {{ section.settings.support_label }}
        </a>
      </div>
    {% endif %}
  </div>
</section>

{% schema %}
{
  "name": "PawPath FAQ",
  "tag": "section",
  "class": "pawpath-section",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "FAQ" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Questions before you shop?" },
    { "type": "textarea", "id": "subheading", "label": "Subheading", "default": "Shipping, returns, sizing, and support — answered." },
    { "type": "text", "id": "support_text", "label": "Support text", "default": "Still have questions? Our team is here to help." },
    { "type": "text", "id": "support_label", "label": "Support button", "default": "Contact support" },
    { "type": "url", "id": "support_link", "label": "Support link" }
  ],
  "blocks": [
    {
      "type": "faq",
      "name": "FAQ item",
      "settings": [
        { "type": "text", "id": "question", "label": "Question", "default": "Where do you ship?" },
        { "type": "richtext", "id": "answer", "label": "Answer", "default": "<p>We ship throughout the United States. Most orders arrive within 3–7 business days after processing.</p>" }
      ]
    }
  ],
  "presets": [
    {
      "name": "PawPath FAQ",
      "blocks": [
        { "type": "faq", "settings": { "question": "Where do you ship?", "answer": "<p>We ship throughout the United States. Most orders arrive within 3–7 business days after processing.</p>" } },
        { "type": "faq", "settings": { "question": "What is your return policy?", "answer": "<p>Unused items in original packaging can be returned within 30 days. Contact our support team and we'll help you through the process.</p>" } },
        { "type": "faq", "settings": { "question": "Are your products safe for all dog sizes?", "answer": "<p>Most PawPath gear fits small through large breeds. Check individual product pages for size guidance and weight recommendations.</p>" } },
        { "type": "faq", "settings": { "question": "How do I track my order?", "answer": "<p>You'll receive a tracking link via email once your order ships. Most orders process within 1–2 business days.</p>" } },
        { "type": "faq", "settings": { "question": "Is checkout secure?", "answer": "<p>Yes. All payments are processed through Shopify's encrypted checkout. We never store your payment details.</p>" } }
      ]
    }
  ]
}
{% endschema %}
