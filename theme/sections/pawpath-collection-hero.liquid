{% liquid
  assign col = collection
  assign col_image = col.image
  assign hero_position = 'center 40%'
  case col.handle
    when 'car-essentials'
      assign hero_position = 'center 30%'
    when 'travel-gear'
      assign hero_position = 'center 45%'
    when 'feeding-hydration'
      assign hero_position = 'center 50%'
    when 'enrichment'
      assign hero_position = 'center 40%'
  endcase
%}

<div class="pawpath pawpath__collection-hero">
  <div class="pawpath__collection-hero-media" style="--collection-hero-position: {{ hero_position }};">
    {% if col_image != blank %}
      {{ col_image | image_url: width: 2000 | image_tag: loading: 'eager', sizes: '100vw', alt: col.title, class: 'pawpath__collection-hero-img' }}
    {% else %}
      {% liquid
        assign collection_asset = ''
        case col.handle
          when 'travel-gear'
            assign collection_asset = 'collection-travel'
          when 'car-essentials'
            assign collection_asset = 'collection-car'
          when 'feeding-hydration'
            assign collection_asset = 'collection-feeding'
          when 'enrichment'
            assign collection_asset = 'collection-enrichment'
          when 'bundles'
            assign collection_asset = 'collection-bundles'
          else
            assign collection_asset = 'hero'
        endcase
      %}
      {% render 'pawpath-render-image',
        asset: collection_asset,
        width: 1600,
        loading: 'eager',
        sizes: '100vw',
        alt: col.title,
        class: 'pawpath__collection-hero-img'
      %}
    {% endif %}
    <div class="pawpath__container pawpath__collection-hero-content">
      <div class="pawpath__collection-hero-text">
        <p class="pawpath__eyebrow pawpath__eyebrow--light">PawPath Collection</p>
        <h1 class="pawpath__heading pawpath__heading--section">{{ col.title }}</h1>
        {% if col.description != blank %}
          <div class="pawpath__lead pawpath__collection-desc">{{ col.description }}</div>
        {% else %}
          <p class="pawpath__lead">Practical dog travel, feeding, and car gear for walks, road trips, and park days.</p>
        {% endif %}
      </div>
    </div>
  </div>
</div>

{% schema %}
{
  "name": "PawPath collection hero",
  "enabled_on": { "templates": ["collection"] },
  "presets": [{ "name": "PawPath collection hero" }]
}
{% endschema %}
