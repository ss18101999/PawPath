{% comment %}
  PawPath contact page — premium layout with hero, contact channels, and styled form.
{% endcomment %}

{% liquid
  assign support_email = section.settings.support_email | default: 'support@pawpathsupply.com'
  if support_email == blank
    assign support_email = 'support@pawpathsupply.com'
  endif
  assign form_id = 'PawPathContact-' | append: section.id
%}

<section class="pawpath pawpath__contact-page" id="pawpath-contact-{{ section.id }}">
  <div class="pawpath__contact-hero">
    <div class="pawpath__contact-hero-media" aria-hidden="true">
      {% if section.settings.hero_image != blank %}
        {{
          section.settings.hero_image
          | image_url: width: 1800
          | image_tag:
            loading: 'eager',
            fetchpriority: 'high',
            widths: '800,1200,1800',
            sizes: '100vw',
            alt: '',
            class: 'pawpath__contact-hero-img pawpath__cover-img'
        }}
      {% else %}
        {% render 'pawpath-render-image',
          asset: 'lifestyle-walk',
          loading: 'eager',
          sizes: '100vw',
          alt: 'Dog on a walk with owner',
          class: 'pawpath__contact-hero-img'
        %}
      {% endif %}
    </div>
    <div class="pawpath__contact-hero-overlay" aria-hidden="true"></div>
    <div class="pawpath__contact-hero-pattern" aria-hidden="true">
      <svg viewBox="0 0 320 120" fill="none" xmlns="http://www.w3.org/2000/svg">
        <path d="M0 80 C60 40 120 100 180 60 C220 35 260 70 320 45" stroke="currentColor" stroke-width="2" stroke-linecap="round" opacity="0.35"/>
        <circle cx="48" cy="62" r="5" fill="currentColor" opacity="0.25"/>
        <circle cx="120" cy="78" r="4" fill="currentColor" opacity="0.2"/>
        <circle cx="196" cy="52" r="5" fill="currentColor" opacity="0.25"/>
        <circle cx="268" cy="58" r="4" fill="currentColor" opacity="0.2"/>
      </svg>
    </div>
    <div class="pawpath__container pawpath__contact-hero-content">
      <p class="pawpath__eyebrow pawpath__eyebrow--light">{{ section.settings.eyebrow }}</p>
      <h1 class="pawpath__heading pawpath__heading--section pawpath__contact-hero-title">{{ section.settings.heading }}</h1>
      <p class="pawpath__lead pawpath__lead--light pawpath__contact-hero-lead">{{ section.settings.lead }}</p>
    </div>
  </div>

  <div class="pawpath__contact-main">
    <div class="pawpath__container">
      <div class="pawpath__contact-grid">
        <aside class="pawpath__contact-sidebar">
          <div class="pawpath__contact-graphic" aria-hidden="true">
            <div class="pawpath__contact-graphic-ring">
              {% render 'pawpath-icons', icon: 'paw' %}
            </div>
            <svg class="pawpath__contact-graphic-trail" viewBox="0 0 200 200" fill="none" xmlns="http://www.w3.org/2000/svg">
              <path d="M20 160 C55 120 75 90 100 100 C125 110 145 70 180 40" stroke="currentColor" stroke-width="1.5" stroke-dasharray="6 8" opacity="0.45"/>
              <ellipse cx="42" cy="148" rx="5" ry="6" fill="currentColor" opacity="0.18"/>
              <ellipse cx="88" cy="108" rx="4" ry="5" fill="currentColor" opacity="0.14"/>
              <ellipse cx="132" cy="88" rx="5" ry="6" fill="currentColor" opacity="0.18"/>
              <ellipse cx="168" cy="48" rx="4" ry="5" fill="currentColor" opacity="0.14"/>
            </svg>
          </div>

          <div class="pawpath__contact-channels">
            <article class="pawpath__contact-channel">
              <div class="pawpath__contact-channel-icon">{% render 'pawpath-icons', icon: 'mail' %}</div>
              <div>
                <h2>Email us</h2>
                <p><a href="mailto:{{ support_email }}">{{ support_email }}</a></p>
              </div>
            </article>

            <article class="pawpath__contact-channel">
              <div class="pawpath__contact-channel-icon">{% render 'pawpath-icons', icon: 'clock' %}</div>
              <div>
                <h2>Response time</h2>
                <p>{{ section.settings.response_time }}</p>
              </div>
            </article>

            {% if section.settings.phone != blank %}
              <article class="pawpath__contact-channel">
                <div class="pawpath__contact-channel-icon">{% render 'pawpath-icons', icon: 'message' %}</div>
                <div>
                  <h2>Phone</h2>
                  <p><a href="tel:{{ section.settings.phone | replace: ' ', '' | replace: '-', '' }}">{{ section.settings.phone }}</a></p>
                </div>
              </article>
            {% endif %}
          </div>

          <div class="pawpath__contact-help">
            <h3>Before you write</h3>
            <p>{{ section.settings.sidebar_note }}</p>
            <ul class="pawpath__contact-quick-links">
              <li>
                <a href="{{ section.settings.faq_link | default: '/pages/faq' }}">
                  {% render 'pawpath-icons', icon: 'shield' %}
                  <span>FAQ</span>
                </a>
              </li>
              <li>
                <a href="{{ section.settings.shipping_link | default: '/pages/shipping-returns' }}">
                  {% render 'pawpath-icons', icon: 'truck' %}
                  <span>Shipping & Returns</span>
                </a>
              </li>
            </ul>
          </div>
        </aside>

        <div class="pawpath__contact-form-wrap">
          <div class="pawpath__contact-form-card">
            <div class="pawpath__contact-form-header">
              <h2>{{ section.settings.form_heading }}</h2>
              <p>{{ section.settings.form_lead }}</p>
            </div>

            {%- form 'contact', id: form_id, class: 'pawpath__contact-form' -%}
              <input type="hidden" name="contact[id]" value="{{ form_id }}">

              {%- if form.errors and form.id == form_id -%}
                <div class="pawpath__contact-alert pawpath__contact-alert--error" role="alert" tabindex="-1" autofocus>
                  <p>{{ form.errors.translated_fields.email | capitalize }} {{ form.errors.messages.email }}</p>
                </div>
              {%- endif -%}

              {%- if form.posted_successfully? and form.id == form_id -%}
                <div class="pawpath__contact-alert pawpath__contact-alert--success" role="status" tabindex="-1" autofocus>
                  <div class="pawpath__contact-success-icon" aria-hidden="true">{% render 'pawpath-icons', icon: 'shield' %}</div>
                  <div>
                    <strong>{{ section.settings.success_title }}</strong>
                    <p>{{ section.settings.success_message }}</p>
                  </div>
                </div>
              {%- else -%}
                <div class="pawpath__contact-form-row">
                  <div class="pawpath__contact-field">
                    <label for="ContactForm-name-{{ section.id }}">Name</label>
                    <input
                      type="text"
                      id="ContactForm-name-{{ section.id }}"
                      name="contact[name]"
                      autocomplete="name"
                      placeholder="Your name"
                      value="{% if form.name %}{{ form.name }}{% elsif customer %}{{ customer.name }}{% endif %}"
                    >
                  </div>
                  <div class="pawpath__contact-field">
                    <label for="ContactForm-email-{{ section.id }}">Email <span aria-hidden="true">*</span></label>
                    <input
                      type="email"
                      id="ContactForm-email-{{ section.id }}"
                      name="contact[email]"
                      autocomplete="email"
                      placeholder="you@email.com"
                      required
                      spellcheck="false"
                      autocapitalize="off"
                      value="{% if form.email %}{{ form.email }}{% elsif customer %}{{ customer.email }}{% endif %}"
                      {% if form.errors contains 'email' and form.id == form_id %}
                        aria-invalid="true"
                      {% endif %}
                    >
                  </div>
                </div>

                <div class="pawpath__contact-form-row">
                  <div class="pawpath__contact-field">
                    <label for="ContactForm-topic-{{ section.id }}">Topic</label>
                    <select id="ContactForm-topic-{{ section.id }}" name="contact[Topic]">
                      <option value="General question">General question</option>
                      <option value="Order status">Order status</option>
                      <option value="Returns & exchanges">Returns & exchanges</option>
                      <option value="Product recommendation">Product recommendation</option>
                      <option value="Wholesale / partnership">Wholesale / partnership</option>
                    </select>
                  </div>
                  <div class="pawpath__contact-field">
                    <label for="ContactForm-phone-{{ section.id }}">Phone <span class="pawpath__contact-optional">(optional)</span></label>
                    <input
                      type="tel"
                      id="ContactForm-phone-{{ section.id }}"
                      name="contact[phone]"
                      autocomplete="tel"
                      placeholder="For faster order help"
                      value="{% if form.phone %}{{ form.phone }}{% elsif customer %}{{ customer.phone }}{% endif %}"
                    >
                  </div>
                </div>

                <div class="pawpath__contact-field">
                  <label for="ContactForm-order-{{ section.id }}">Order number <span class="pawpath__contact-optional">(optional)</span></label>
                  <input
                    type="text"
                    id="ContactForm-order-{{ section.id }}"
                    name="contact[Order number]"
                    placeholder="#1234"
                  >
                </div>

                <div class="pawpath__contact-field">
                  <label for="ContactForm-body-{{ section.id }}">Message <span aria-hidden="true">*</span></label>
                  <textarea
                    id="ContactForm-body-{{ section.id }}"
                    name="contact[body]"
                    rows="6"
                    required
                    placeholder="Tell us how we can help — the more detail, the better we can assist."
                  >{{ form.body }}</textarea>
                </div>

                <button type="submit" class="pawpath__button pawpath__button--primary pawpath__contact-submit">
                  {{ section.settings.submit_label }}
                </button>
                <p class="pawpath__contact-form-fine">{{ section.settings.form_fine_print }}</p>
              {%- endif -%}
            {%- endform -%}
          </div>
        </div>
      </div>
    </div>
  </div>

  <div class="pawpath__contact-trust">
    <div class="pawpath__container">
      <div class="pawpath__contact-trust-grid">
        <article class="pawpath__contact-trust-card">
          <div class="pawpath__trust-icon pawpath__trust-icon--large">{% render 'pawpath-icons', icon: 'paw' %}</div>
          <h3>Dog parents, not bots</h3>
          <p>Real people who understand travel with dogs — thoughtful replies, never copy-paste scripts.</p>
        </article>
        <article class="pawpath__contact-trust-card">
          <div class="pawpath__trust-icon pawpath__trust-icon--large">{% render 'pawpath-icons', icon: 'truck' %}</div>
          <h3>Order help fast</h3>
          <p>Include your order number and we’ll pull up tracking, changes, or return steps right away.</p>
        </article>
        <article class="pawpath__contact-trust-card">
          <div class="pawpath__trust-icon pawpath__trust-icon--large">{% render 'pawpath-icons', icon: 'return' %}</div>
          <h3>Hassle-free returns</h3>
          <p>30-day returns on unused gear. We’ll walk you through it — no runaround.</p>
        </article>
      </div>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "PawPath contact page",
  "settings": [
    { "type": "image_picker", "id": "hero_image", "label": "Hero image" },
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "We're here to help" },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Let's plan your dog's next adventure."
    },
    {
      "type": "textarea",
      "id": "lead",
      "label": "Lead text",
      "default": "Questions about an order, a product fit, or the right gear for your trip? Our team of dog parents is ready to help."
    },
    {
      "type": "text",
      "id": "support_email",
      "label": "Support email",
      "default": "support@pawpathsupply.com"
    },
    {
      "type": "text",
      "id": "phone",
      "label": "Phone number (optional)"
    },
    {
      "type": "text",
      "id": "response_time",
      "label": "Response time",
      "default": "We reply within 1 business day — often sooner."
    },
    {
      "type": "textarea",
      "id": "sidebar_note",
      "label": "Sidebar note",
      "default": "Many answers are already in our FAQ and shipping guides — you may find what you need instantly."
    },
    { "type": "url", "id": "faq_link", "label": "FAQ link" },
    { "type": "url", "id": "shipping_link", "label": "Shipping link" },
    {
      "type": "text",
      "id": "form_heading",
      "label": "Form heading",
      "default": "Send us a message"
    },
    {
      "type": "text",
      "id": "form_lead",
      "label": "Form lead",
      "default": "Fill out the form and we'll get back to you by email."
    },
    { "type": "text", "id": "submit_label", "label": "Submit button", "default": "Send message" },
    {
      "type": "text",
      "id": "form_fine_print",
      "label": "Form fine print",
      "default": "By submitting, you agree we may email you about your request. We never share your information."
    },
    {
      "type": "text",
      "id": "success_title",
      "label": "Success title",
      "default": "Message received!"
    },
    {
      "type": "textarea",
      "id": "success_message",
      "label": "Success message",
      "default": "Thanks for reaching out. A member of our team will reply to your email within one business day."
    }
  ],
  "presets": [{ "name": "PawPath contact page" }]
}
{% endschema %}
