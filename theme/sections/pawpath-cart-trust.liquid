{% comment %}
  Cart page trust — delivery-focused (secure checkout shown once in trust section).
{% endcomment %}

<div class="pawpath pawpath__cart-trust">
  <div class="pawpath__container">
    <div class="pawpath__cart-trust-grid">
      <div class="pawpath__cart-trust-item">
        {% render 'pawpath-icons', icon: 'truck' %}
        <span>Free US shipping on orders over $50</span>
      </div>
      <div class="pawpath__cart-trust-item">
        {% render 'pawpath-icons', icon: 'return' %}
        <span>30-day easy returns</span>
      </div>
      <div class="pawpath__cart-trust-item">
        {% render 'pawpath-icons', icon: 'lock' %}
        <span>Secure Shopify checkout</span>
      </div>
      <div class="pawpath__cart-trust-item">
        {% render 'pawpath-icons', icon: 'shield' %}
        <span>Quality guaranteed · <a href="/pages/contact">Need help?</a></span>
      </div>
    </div>
  </div>
</div>

{% schema %}
{
  "name": "PawPath cart trust",
  "enabled_on": { "templates": ["cart"] },
  "presets": [{ "name": "PawPath cart trust" }]
}
{% endschema %}
