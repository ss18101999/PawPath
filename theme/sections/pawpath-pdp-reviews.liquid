{% comment %}
  PDP reviews section — honest social proof.
  Uses Shopify Reviews metafields when available; falls back to configurable editorial quotes.
  Does NOT fabricate star counts when no real reviews exist.
{% endcomment %}

{% liquid
  assign product = section.settings.product
  if product == blank
    assign product = closest.product
  endif
  assign rating = product.metafields.reviews.rating.value.rating
  assign rating_count = product.metafields.reviews.rating_count
  assign has_real_reviews = false
  if rating != blank and rating_count != blank and rating_count > 0
    assign has_real_reviews = true
  endif
%}

<section class="pawpath pawpath__pdp-reviews pawpath__section--sand" id="pawpath-reviews-{{ section.id }}">
  <div class="pawpath__container">
    <div class="pawpath__section-header pawpath__section-header--center">
      <p class="pawpath__eyebrow">{{ section.settings.eyebrow }}</p>
      <h2 class="pawpath__heading pawpath__heading--section">{{ section.settings.heading }}</h2>
      {% if has_real_reviews %}
        <div class="pawpath__pdp-reviews-aggregate">
          {% render 'pawpath-pdp-rating', product: product %}
          <span class="pawpath__pdp-reviews-count">Based on {{ rating_count }} verified reviews</span>
        </div>
      {% elsif section.settings.fallback_subheading != blank %}
        <p class="pawpath__lead pawpath__lead--center">{{ section.settings.fallback_subheading }}</p>
      {% endif %}
    </div>

    {% if section.blocks.size > 0 %}
      <div class="pawpath__grid pawpath__grid--3">
        {% for block in section.blocks %}
          {% if block.type == 'review' %}
            <article class="pawpath__review-card" {{ block.shopify_attributes }}>
              {% if has_real_reviews %}
                <div class="pawpath__review-stars" aria-label="{{ block.settings.rating }} out of 5 stars">
                  {% for i in (1..5) %}
                    {% if i <= block.settings.rating %}★{% else %}☆{% endif %}
                  {% endfor %}
                </div>
              {% endif %}
              <p class="pawpath__review-quote">"{{ block.settings.quote }}"</p>
              <div class="pawpath__review-author">
                <div class="pawpath__review-avatar">{% render 'pawpath-icons', icon: 'paw' %}</div>
                <div>
                  <strong>{{ block.settings.author }}</strong>
                  <span class="pawpath__review-detail">{{ block.settings.detail }}</span>
                </div>
              </div>
            </article>
          {% endif %}
        {% endfor %}
      </div>
    {% endif %}

    {% if section.settings.show_app_note and has_real_reviews == false %}
      <p class="pawpath__reviews-note">{{ section.settings.app_note }}</p>
    {% endif %}
  </div>
</section>

{% schema %}
{
  "name": "PawPath PDP reviews",
  "tag": "section",
  "class": "pawpath-pdp-section",
  "settings": [
    { "type": "product", "id": "product", "label": "Product override" },
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "Reviews" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "What dog parents are saying" },
    {
      "type": "text",
      "id": "fallback_subheading",
      "label": "Subheading (when no app reviews)",
      "default": "Early feedback from dog parents who travel with their pups."
    },
    { "type": "checkbox", "id": "show_app_note", "label": "Show review app note", "default": false },
    {
      "type": "text",
      "id": "app_note",
      "label": "App note",
      "default": "Install Shopify Product Reviews or Judge.me to display verified customer ratings."
    }
  ],
  "blocks": [
    {
      "type": "review",
      "name": "Review",
      "settings": [
        { "type": "textarea", "id": "quote", "label": "Quote" },
        { "type": "text", "id": "author", "label": "Author" },
        { "type": "text", "id": "detail", "label": "Detail", "default": "Dog parent" },
        { "type": "range", "id": "rating", "label": "Star rating", "min": 1, "max": 5, "step": 1, "default": 5 }
      ]
    }
  ],
  "presets": [
    {
      "name": "PawPath PDP reviews",
      "blocks": [
        { "type": "review", "settings": { "quote": "Exactly what we needed for road trips with our lab.", "author": "Morgan R.", "detail": "Road trip essentials", "rating": 5 } },
        { "type": "review", "settings": { "quote": "Well made and easy to clean after park days.", "author": "Alex P.", "detail": "Daily walks", "rating": 5 } },
        { "type": "review", "settings": { "quote": "Fits perfectly in our car setup.", "author": "Jamie L.", "detail": "Car travel gear", "rating": 5 } }
      ]
    }
  ]
}
{% endschema %}
