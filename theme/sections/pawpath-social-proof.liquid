{% comment %}
  Premium social proof strip — stats, trust signals, and editorial proof points.
  Placed below hero to reduce bounce and establish brand credibility early.
{% endcomment %}

<section class="pawpath pawpath__social-proof" id="pawpath-social-{{ section.id }}" aria-label="{{ section.settings.aria_label }}">
  <div class="pawpath__container">
    {% if section.settings.show_heading %}
      <div class="pawpath__social-proof-header">
        <p class="pawpath__eyebrow">{{ section.settings.eyebrow }}</p>
        {% if section.settings.heading != blank %}
          <h2 class="pawpath__social-proof-lead">{{ section.settings.heading }}</h2>
        {% endif %}
      </div>
    {% endif %}

    <div class="pawpath__social-proof-grid" role="list">
      {% for block in section.blocks %}
        {% if block.type == 'stat' %}
          <div class="pawpath__social-proof-stat" role="listitem" {{ block.shopify_attributes }}>
            {% if block.settings.icon != 'none' %}
              <div class="pawpath__social-proof-icon">
                {% render 'pawpath-icons', icon: block.settings.icon %}
              </div>
            {% endif %}
            <p class="pawpath__social-proof-value">{{ block.settings.value }}</p>
            <p class="pawpath__social-proof-label">{{ block.settings.label }}</p>
          </div>
        {% elsif block.type == 'metric_placeholder' %}
          {% unless block.settings.placeholder_value contains '[INSERT' %}
          <div class="pawpath__social-proof-stat pawpath__social-proof-stat--placeholder" role="listitem" {{ block.shopify_attributes }}>
            {% if block.settings.icon != 'none' %}
              <div class="pawpath__social-proof-icon">
                {% render 'pawpath-icons', icon: block.settings.icon %}
              </div>
            {% endif %}
            <p class="pawpath__metric-placeholder-value">{{ block.settings.placeholder_value }}</p>
            <p class="pawpath__social-proof-label">{{ block.settings.label }}</p>
          </div>
          {% endunless %}
        {% endif %}
      {% endfor %}
    </div>

    {% if section.settings.show_placeholder_note %}
      <p class="pawpath__metric-placeholder-note pawpath__metric-placeholder-note--center">{{ section.settings.placeholder_note }}</p>
    {% endif %}
  </div>
</section>

{% schema %}
{
  "name": "PawPath social proof",
  "tag": "section",
  "class": "pawpath-section",
  "settings": [
    {
      "type": "text",
      "id": "aria_label",
      "label": "Accessibility label",
      "default": "Why dog owners choose PawPath"
    },
    {
      "type": "checkbox",
      "id": "show_heading",
      "label": "Show section intro",
      "default": false
    },
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow",
      "default": "Trusted by dog parents"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Intro line",
      "default": "Gear designed for real walks, road trips, and park days."
    },
    {
      "type": "checkbox",
      "id": "show_placeholder_note",
      "label": "Show placeholder admin note",
      "default": false
    },
    {
      "type": "text",
      "id": "placeholder_note",
      "label": "Placeholder note (admin only)",
      "default": "Replace bracketed placeholders with verified metrics from your analytics and review platform."
    }
  ],
  "blocks": [
    {
      "type": "stat",
      "name": "Proof point",
      "settings": [
        {
          "type": "text",
          "id": "value",
          "label": "Number or headline",
          "default": "1,200+"
        },
        {
          "type": "text",
          "id": "label",
          "label": "Label",
          "default": "Happy dog parents"
        },
        {
          "type": "select",
          "id": "icon",
          "label": "Icon",
          "options": [
            { "value": "none", "label": "None" },
            { "value": "paw", "label": "Paw" },
            { "value": "truck", "label": "Shipping" },
            { "value": "return", "label": "Returns" },
            { "value": "shield", "label": "Quality" },
            { "value": "walk", "label": "Walk" }
          ],
          "default": "paw"
        }
      ]
    },
    {
      "type": "metric_placeholder",
      "name": "Metric placeholder",
      "settings": [
        {
          "type": "text",
          "id": "placeholder_value",
          "label": "Placeholder value",
          "default": "[INSERT VERIFIED CUSTOMER COUNT]"
        },
        {
          "type": "text",
          "id": "label",
          "label": "Label",
          "default": "Dog parents served"
        },
        {
          "type": "select",
          "id": "icon",
          "label": "Icon",
          "options": [
            { "value": "none", "label": "None" },
            { "value": "paw", "label": "Paw" },
            { "value": "truck", "label": "Shipping" },
            { "value": "shield", "label": "Quality" }
          ],
          "default": "paw"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "PawPath social proof",
      "blocks": [
        {
          "type": "stat",
          "settings": {
            "value": "1,200+",
            "label": "Happy dog parents",
            "icon": "paw"
          }
        },
        {
          "type": "stat",
          "settings": {
            "value": "2,500+",
            "label": "Orders shipped",
            "icon": "truck"
          }
        },
        {
          "type": "stat",
          "settings": {
            "value": "30 Days",
            "label": "Easy returns on unused gear",
            "icon": "return"
          }
        },
        {
          "type": "stat",
          "settings": {
            "value": "Dog-First",
            "label": "Designed by pet parents, for pet parents",
            "icon": "shield"
          }
        }
      ]
    }
  ]
}
{% endschema %}
