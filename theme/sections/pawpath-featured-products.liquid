{% comment %}
  Branded featured product grid — matches PawPath design system (replaces generic Horizon product-list on homepage).
  Mobile-first: 2-column grid, portrait imagery, minimal cognitive load.
{% endcomment %}

{% liquid
  assign featured_collection = section.settings.collection
  if featured_collection == blank and section.settings.collection_handle != blank
    assign featured_collection = collections[section.settings.collection_handle]
  endif
  assign product_limit = section.settings.max_products
%}

<section class="pawpath pawpath__featured-products" id="pawpath-featured-{{ section.id }}">
  <div class="pawpath__container">
    <div class="pawpath__featured-header">
      <div>
        {% if section.settings.eyebrow != blank %}
          <p class="pawpath__eyebrow">{{ section.settings.eyebrow }}</p>
        {% endif %}
        <h2 class="pawpath__heading pawpath__heading--section">{{ section.settings.heading }}</h2>
        {% if section.settings.description != blank %}
          <p class="pawpath__lead">{{ section.settings.description }}</p>
        {% endif %}
      </div>
      {% if section.settings.show_view_all and featured_collection != blank %}
        <a class="pawpath__button pawpath__button--outline pawpath__featured-view-all" href="{{ featured_collection.url }}">
          {{ section.settings.view_all_label }}
        </a>
      {% endif %}
    </div>

    {% if featured_collection != blank and featured_collection.products_count > 0 %}
      <ul class="pawpath__featured-grid" role="list">
        {% for product in featured_collection.products limit: product_limit %}
          <li class="pawpath__featured-card-wrap" role="listitem">
            <a class="pawpath__featured-card" href="{{ product.url }}">
              <div class="pawpath__featured-media">
                {% if product.featured_image != blank %}
                  {{
                    product.featured_image
                    | image_url: width: 800
                    | image_tag:
                      loading: 'lazy',
                      widths: '400,600,800',
                      sizes: '(max-width: 640px) 50vw, 25vw',
                      alt: product.featured_image.alt | default: product.title,
                      class: 'pawpath__featured-img'
                  }}
                {% else %}
                  {% render 'pawpath-product-fallback-image', product: product, class: 'pawpath__featured-img' %}
                {% endif %}
                {% render 'pawpath-rating', product: product %}
              </div>
              <div class="pawpath__featured-info">
                <h3 class="pawpath__featured-title">{{ product.title }}</h3>
                <p class="pawpath__featured-price">
                  {% if product.compare_at_price > product.price %}
                    <span class="pawpath__featured-price--sale">{{ product.price | money }}</span>
                    <span class="pawpath__featured-price--compare">{{ product.compare_at_price | money }}</span>
                  {% else %}
                    {{ product.price | money }}
                  {% endif %}
                </p>
              </div>
            </a>
          </li>
        {% endfor %}
      </ul>
    {% else %}
      <p class="pawpath__featured-empty">{{ section.settings.empty_message }}</p>
    {% endif %}
  </div>
</section>

{% schema %}
{
  "name": "PawPath featured products",
  "tag": "section",
  "class": "pawpath-section",
  "settings": [
    {
      "type": "collection",
      "id": "collection",
      "label": "Collection"
    },
    {
      "type": "text",
      "id": "collection_handle",
      "label": "Collection handle (fallback)",
      "default": "all"
    },
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow",
      "default": "Best Sellers"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Shop Dog Travel Essentials"
    },
    {
      "type": "textarea",
      "id": "description",
      "label": "Description",
      "default": "Portable feeding gear, hydration bottles, car protection, and enrichment favorites dog owners reach for every day."
    },
    {
      "type": "range",
      "id": "max_products",
      "label": "Maximum products",
      "min": 4,
      "max": 12,
      "step": 1,
      "default": 8
    },
    {
      "type": "checkbox",
      "id": "show_view_all",
      "label": "Show view all link",
      "default": true
    },
    {
      "type": "text",
      "id": "view_all_label",
      "label": "View all label",
      "default": "Shop all"
    },
    {
      "type": "text",
      "id": "empty_message",
      "label": "Empty collection message",
      "default": "Add products to this collection to display them here."
    }
  ],
  "presets": [
    {
      "name": "PawPath featured products",
      "settings": {
        "collection_handle": "all",
        "heading": "Shop Dog Travel Essentials"
      }
    }
  ]
}
{% endschema %}
