{% comment %}
  PawPath premium product page — custom layout, not generic Horizon product-information.
{% endcomment %}

<script type="application/ld+json">
  {{ product | structured_data }}
</script>

{% capture media_gallery %}
  {% content_for 'block',
    type: '_product-media-gallery',
    id: 'media-gallery',
    closest.product: product
  %}
{% endcapture %}

{% capture product_details %}
  {% content_for 'block',
    type: '_product-details',
    id: 'product-details',
    closest.product: product
  %}
{% endcapture %}

{% render 'pawpath-product-layout',
  product: product,
  section_id: section.id,
  settings: section.settings,
  media_gallery: media_gallery,
  product_details: product_details,
  product_media_size: product.media.size
%}

{% if section.settings.enable_sticky_add_to_cart %}
  {% liquid
    assign current_variant = product.selected_or_first_available_variant
    assign initial_quantity = current_variant.quantity_rule.min | default: 1
    assign image_to_show = current_variant.featured_image | default: product.featured_image
    if image_to_show == blank
      assign sticky_has_image = false
    else
      assign sticky_has_image = true
    endif
  %}
  <sticky-add-to-cart
    class="sticky-add-to-cart pawpath-pdp__sticky"
    data-variant-available="{{ current_variant.available }}"
    data-product-id="{{ product.id }}"
    data-current-variant-id="{{ current_variant.id }}"
    data-initial-quantity="{{ initial_quantity }}"
    data-default-variant-title="{{ 'products.product.default_title' | t }}"
  >
    <div
      class="sticky-add-to-cart__bar pawpath-pdp__sticky-bar"
      data-stuck="false"
      ref="stickyBar"
      role="region"
      aria-label="{{ 'products.product.sticky_add_to_cart' | t }}"
    >
      {% if image_to_show %}
        <div class="sticky-add-to-cart__image">
          {{ image_to_show | image_url: width: 120 | image_tag: loading: 'lazy', alt: product.title, class: 'sticky-add-to-cart__image-img', ref: 'productImage' }}
        </div>
      {% endif %}
      <div
        class="sticky-add-to-cart__info"
        data-has-image="{{ sticky_has_image }}"
        data-singleton="{{ product.has_only_default_variant }}"
      >
        <p class="sticky-add-to-cart__title">{{ product.title | escape }}</p>
        <div class="sticky-add-to-cart__price">{% render 'price', product_resource: product, show_sale_price_first: true %}</div>
      </div>
      <button
        type="button"
        class="sticky-add-to-cart__button pawpath-pdp__sticky-btn add-to-cart-button button"
        ref="addToCartButton"
        on:click="/handleAddToCartClick"
        {% unless current_variant.available %}disabled{% endunless %}
      >
        <span class="add-to-cart-text">
          {%- if current_variant.available -%}{{ 'products.product.add_to_cart' | t }}{%- else -%}{{ 'products.product.sold_out' | t }}{%- endif -%}
        </span>
      </button>
    </div>
  </sticky-add-to-cart>
{% endif %}

{% schema %}
{
  "name": "PawPath product",
  "tag": "section",
  "class": "pawpath-pdp-section",
  "blocks": [
    { "type": "@app" }
  ],
  "settings": [
    {
      "type": "checkbox",
      "id": "enable_sticky_add_to_cart",
      "label": "Enable sticky add to cart",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_trust_ribbon",
      "label": "Show trust ribbon below header",
      "info": "Off by default — the site announcement bar already shows shipping and returns.",
      "default": false
    },
    {
      "type": "text",
      "id": "trust_ribbon_text",
      "label": "Trust ribbon text",
      "default": "Free US shipping $50+ · 30-day returns · Secure checkout",
      "visible_if": "{{ section.settings.show_trust_ribbon }}"
    }
  ]
}
{% endschema %}
